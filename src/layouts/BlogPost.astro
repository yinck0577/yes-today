---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCategoryName, SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { currentId?: string };

const { title, description, pubDate, updatedDate, heroImage, category, currentId } = Astro.props;

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestOverall = allPosts[0];
const latestPick =
	latestOverall && latestOverall.id === currentId ? allPosts[1] : latestOverall;

function shuffle<T>(arr: T[]): T[] {
	const a = [...arr];
	for (let i = a.length - 1; i > 0; i--) {
		const j = Math.floor(Math.random() * (i + 1));
		[a[i], a[j]] = [a[j], a[i]];
	}
	return a;
}

const sameCategoryPool = allPosts.filter(
	(p) => p.id !== currentId && p.data.category === category && (!latestPick || p.id !== latestPick.id),
);
const randomPicks = shuffle(sameCategoryPool).slice(0, 2);

const related = [latestPick, ...randomPicks].filter(Boolean) as typeof allPosts;

const counterKey = `yes-today-post-${currentId}`;

const absoluteImageURL = heroImage ? new URL(heroImage, Astro.url) : undefined;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const articleLD = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	image: absoluteImageURL ? [absoluteImageURL.toString()] : undefined,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: [{ '@type': 'Organization', name: SITE_TITLE }],
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		logo: { '@type': 'ImageObject', url: new URL('/yestodaylogo.png', Astro.url).toString() },
	},
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
	articleSection: category ? getCategoryName(category) : undefined,
	inLanguage: 'zh-Hant',
};
---

<html lang="zh-Hant">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
		<script type="application/ld+json" set:html={JSON.stringify(articleLD)} />
		<style>
			#reading-progress-bar {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 3px;
				background: var(--accent);
				transform: scaleX(0);
				transform-origin: left center;
				z-index: 60;
				pointer-events: none;
			}
			@media (max-width: 720px) {
				#reading-progress-bar {
					height: 2px;
				}
			}
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: clamp(2rem, 4vw, 3rem);
				font-weight: 700;
				line-height: 1.25;
				letter-spacing: -0.02em;
				word-break: normal;
				overflow-wrap: break-word;
			}
			@media (max-width: 768px) {
				.title h1 {
					font-size: 32px;
					line-height: 1.32;
					font-weight: 700;
					letter-spacing: -0.015em;
					margin-top: 16px;
					margin-bottom: 28px;
				}
			}
			@media (max-width: 390px) {
				.title h1 {
					font-size: 30px;
					line-height: 1.35;
				}
			}
			.prose h2 {
				font-size: 1.6rem;
				font-weight: 600;
				line-height: 1.4;
				margin-top: 1.6em;
			}
			.prose h3 {
				font-size: 1.3rem;
				font-weight: 600;
				line-height: 1.4;
				margin-top: 1.4em;
			}
			@media (max-width: 768px) {
				.prose h2 {
					font-size: 1.35rem;
				}
				.prose h3 {
					font-size: 1.15rem;
				}
			}
			@media (max-width: 390px) {
				.prose h2 {
					font-size: 1.25rem;
				}
				.prose h3 {
					font-size: 1.1rem;
				}
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
				font-size: 0.85em;
			}
			.byline {
				display: block;
			}
			.post-meta {
				display: flex;
				align-items: center;
				justify-content: center;
				flex-wrap: wrap;
				gap: 1em;
				margin: 0.5em 0 1.5em 0;
				padding-bottom: 1em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.view-count {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.share-buttons {
				display: flex;
				gap: 0.6em;
			}
			.share-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				padding: 0.4em 0.9em;
				border-radius: 20px;
				font-size: 0.85rem;
				text-decoration: none;
				color: #fff;
				font-weight: 600;
			}
			.share-btn.fb {
				background: #1877f2;
			}
			.share-btn.line {
				background: #06c755;
			}
			.share-btn:hover {
				opacity: 0.85;
			}
			.share-sidebar {
				position: fixed;
				left: 24px;
				top: 45%;
				transform: translateY(-50%);
				display: flex;
				flex-direction: column;
				gap: 0.8em;
				z-index: 30;
			}
			.share-icon {
				width: 42px;
				height: 42px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				color: #fff;
				text-decoration: none;
				box-shadow: var(--box-shadow);
			}
			.share-icon.fb {
				background: #1877f2;
			}
			.share-icon.line {
				background: #06c755;
			}
			.share-icon:hover {
				opacity: 0.85;
			}
			@media (min-width: 1150px) {
				.post-meta .share-buttons {
					display: none;
				}
			}
			@media (max-width: 1149px) {
				.share-sidebar {
					display: none;
				}
			}
			.related {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 2em auto 3em auto;
				padding: 1em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.related h2 {
				font-size: 1.3rem;
				margin: 1em 0 1em 0;
			}
			.related-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5em;
			}
			.related-list li a {
				display: block;
				text-decoration: none;
			}
			.related-list img {
				width: 100%;
				border-radius: 10px;
				margin-bottom: 0.5em;
				display: block;
			}
			.related-badge {
				display: inline-block;
				background: var(--accent);
				color: #fff;
				font-size: 0.7rem;
				font-weight: 700;
				padding: 0.15em 0.6em;
				border-radius: 4px;
				margin-bottom: 0.4em;
			}
			.related-title {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.45;
				color: rgb(var(--black));
			}
			.related-date {
				margin: 0.3em 0 0 0;
				color: rgb(var(--gray));
				font-size: 0.8rem;
			}
			.related-list a:hover .related-title {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				.related-list {
					grid-template-columns: 1fr;
				}
			}
			.category-tag {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.like-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.35em;
				background: none;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 20px;
				padding: 0.3em 0.9em;
				font-size: 0.9rem;
				color: rgb(var(--gray));
				cursor: pointer;
				line-height: 1;
			}
			.like-btn .like-icon {
				font-size: 1.05rem;
			}
			.like-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.like-btn.is-liked {
				border-color: var(--accent);
				color: var(--accent);
				background: rgba(35, 55, 255, 0.08);
			}
			.like-btn:disabled {
				opacity: 0.6;
				cursor: default;
			}
			.comments-section {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 2em auto 3em auto;
				padding: 1em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.comments-section h2 {
				font-size: 1.3rem;
				margin: 1em 0 1em 0;
			}
			.comments-list {
				list-style: none;
				margin: 0 0 1.5em 0;
				padding: 0;
			}
			.comments-list li {
				padding: 0.9em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.comments-list li:first-child {
				padding-top: 0;
			}
			.comments-status-line {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.comment-author {
				font-weight: 700;
				font-size: 0.9rem;
				color: rgb(var(--black));
				margin-right: 0.6em;
			}
			.comment-date {
				font-size: 0.78rem;
				color: rgb(var(--gray));
			}
			.comment-body {
				margin: 0.4em 0 0 0;
				line-height: 1.7;
				color: rgb(var(--gray-dark));
				word-break: break-word;
			}
			.comment-body a {
				color: var(--accent);
			}
			.comment-form {
				display: flex;
				flex-direction: column;
				gap: 0.6em;
			}
			.comment-toolbar {
				display: flex;
				gap: 0.4em;
			}
			.comment-toolbar button {
				width: 30px;
				height: 30px;
				border-radius: 6px;
				border: 1px solid rgb(var(--gray-light));
				background: #fff;
				cursor: pointer;
				font-size: 0.85rem;
				color: rgb(var(--gray-dark));
			}
			.comment-toolbar button:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			#comment-name,
			#comment-content {
				width: 100%;
				box-sizing: border-box;
				padding: 0.6em 0.8em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				font-family: inherit;
				font-size: 0.95rem;
			}
			#comment-content {
				resize: vertical;
			}
			.comment-form-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
			}
			.comment-char-count {
				font-size: 0.8rem;
				color: rgb(var(--gray));
			}
			.comment-submit {
				background: var(--accent);
				color: #fff;
				border: none;
				border-radius: 20px;
				padding: 0.5em 1.4em;
				font-size: 0.9rem;
				font-weight: 600;
				cursor: pointer;
			}
			.comment-submit:disabled {
				opacity: 0.6;
				cursor: default;
			}
			.comment-status-line {
				min-height: 1.2em;
				font-size: 0.85rem;
				margin: 0;
			}
			.comment-status-line.is-error {
				color: #d33;
			}
			.comment-status-line.is-success {
				color: #1a8a3c;
			}
		</style>
	</head>

	<body>
		<div id="reading-progress-bar"></div>
		<Header />
		<div class="share-sidebar" aria-label="分享這篇文章">
			<a id="share-fb-side" class="share-icon fb" href="#" target="_blank" rel="noopener" aria-label="分享到 Facebook">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
					><path
						fill="currentColor"
						d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z"
					></path></svg
				>
			</a>
			<a id="share-line-side" class="share-icon line" href="#" target="_blank" rel="noopener" aria-label="分享到 LINE">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
					><path
						fill="currentColor"
						d="M12 2C6.48 2 2 5.69 2 10.24c0 4.08 3.54 7.5 8.32 8.15.32.07.76.21.87.49.1.25.06.65.03.9l-.14.85c-.04.25-.19.98.86.53s5.65-3.33 7.71-5.7C21.09 13.5 22 11.96 22 10.24 22 5.69 17.52 2 12 2zm-3.5 11h-1.8a.4.4 0 0 1-.4-.4V8.4a.4.4 0 0 1 .4-.4h.8a.4.4 0 0 1 .4.4v3.4h1.6a.4.4 0 0 1 .4.4v.8a.4.4 0 0 1-.4.4zm2.6-4.6a.4.4 0 0 1-.4.4h-.8a.4.4 0 0 1-.4-.4V8.4a.4.4 0 0 1 .4-.4h.8a.4.4 0 0 1 .4.4zm5.5 4.2a.4.4 0 0 1-.4.4h-.8a.4.4 0 0 1-.32-.16l-1.68-2.27v2.03a.4.4 0 0 1-.4.4h-.8a.4.4 0 0 1-.4-.4V8.4a.4.4 0 0 1 .4-.4h.8c.13 0 .25.06.32.16l1.68 2.27V8.4a.4.4 0 0 1 .4-.4h.8a.4.4 0 0 1 .4.4z"
					></path></svg
				>
			</a>
		</div>
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt={title} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<span class="byline">Yes Today 編輯部｜發布於 <FormattedDate date={pubDate} /></span>
							<div class="last-updated-on">
								最後更新：<FormattedDate date={updatedDate ?? pubDate} />
							</div>
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<div class="post-meta">
						{category && <span class="category-tag">{getCategoryName(category)}</span>}
						<span class="view-count" id="view-count">瀏覽數讀取中...</span>
						<button type="button" class="like-btn" id="like-btn" aria-pressed="false" aria-label="喜歡這篇文章">
							<span class="like-icon" aria-hidden="true">♡</span>
							<span class="like-count" id="like-count">0</span>
						</button>
						<div class="share-buttons">
							<a id="share-fb" class="share-btn fb" href="#" target="_blank" rel="noopener">分享到 Facebook</a>
							<a id="share-line" class="share-btn line" href="#" target="_blank" rel="noopener">分享到 LINE</a>
						</div>
					</div>
					<slot />
				</div>
			</article>
			{
				related.length > 0 && (
					<div class="related">
						<h2>延伸閱讀</h2>
						<ul class="related-list">
							{related.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<img width={360} height={200} src={post.data.heroImage} alt={post.data.title} loading="lazy" />
										)}
										{post.data.category && (
											<span class="related-badge">{getCategoryName(post.data.category)}</span>
										)}
										<h3 class="related-title">{post.data.title}</h3>
										<p class="related-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
			<div class="comments-section" id="comments-section" data-slug={currentId}>
				<h2>留言</h2>
				<ul class="comments-list" id="comments-list">
					<li class="comments-status-line">留言讀取中...</li>
				</ul>
				<form class="comment-form" id="comment-form">
					<div class="comment-toolbar" role="toolbar" aria-label="留言格式工具">
						<button type="button" data-cmd="bold" aria-label="粗體">B</button>
						<button type="button" data-cmd="italic" aria-label="斜體"><em>I</em></button>
						<button type="button" data-cmd="link" aria-label="插入連結">🔗</button>
						<button type="button" data-cmd="newline" aria-label="換行">⏎</button>
					</div>
					<input type="text" id="comment-name" name="name" placeholder="暱稱（留空會自動產生匿名暱稱）" maxlength="30" />
					<textarea id="comment-content" name="content" rows="3" maxlength="500" placeholder="留下你的想法……" required></textarea>
					<div class="comment-form-footer">
						<span class="comment-char-count" id="comment-char-count">0 / 500</span>
						<button type="submit" class="comment-submit" id="comment-submit">送出留言</button>
					</div>
					<p class="comment-status-line" id="comment-status" role="status"></p>
				</form>
			</div>
		</main>
		<Footer />
		<script define:vars={{ counterKey }}>
			const url = window.location.href;
			const fbShareUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url);
			const lineShareUrl = 'https://social-plugins.line.me/lineit/share?url=' + encodeURIComponent(url);
			const fb = document.getElementById('share-fb');
			const line = document.getElementById('share-line');
			const fbSide = document.getElementById('share-fb-side');
			const lineSide = document.getElementById('share-line-side');
			if (fb) fb.href = fbShareUrl;
			if (line) line.href = lineShareUrl;
			if (fbSide) fbSide.href = fbShareUrl;
			if (lineSide) lineSide.href = lineShareUrl;

			const viewEl = document.getElementById('view-count');
			fetch('https://countapi.mileshilliard.com/api/v1/hit/' + encodeURIComponent(counterKey))
				.then((r) => r.json())
				.then((data) => {
					if (viewEl) viewEl.textContent = '👁 ' + data.value + ' 次瀏覽';
				})
				.catch(() => {
					if (viewEl) viewEl.textContent = '';
				});
		</script>
		<script>
			(function () {
				const bar = document.getElementById('reading-progress-bar');
				const article = document.querySelector('article');
				if (!bar || !article) return;
				let ticking = false;
				function update() {
					const rect = article.getBoundingClientRect();
					const total = article.offsetHeight - window.innerHeight;
					let progress = 1;
					if (total > 0) {
						const scrolled = -rect.top;
						progress = Math.min(1, Math.max(0, scrolled / total));
					}
					bar.style.transform = 'scaleX(' + progress + ')';
					ticking = false;
				}
				function onScroll() {
					if (!ticking) {
						window.requestAnimationFrame(update);
						ticking = true;
					}
				}
				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onScroll, { passive: true });
				update();
			})();
		</script>
		<script>
			(function () {
				const prose = document.querySelector('.prose');
				if (!prose) return;
				const links = prose.querySelectorAll('a[href^="http"]');
				links.forEach(function (link) {
					if (link.hostname && link.hostname !== window.location.hostname) {
						link.setAttribute('target', '_blank');
						link.setAttribute('rel', 'noopener noreferrer');
					}
				});
			})();
		</script>
		<script>
			(function () {
				const slug = document.getElementById('comments-section')?.getAttribute('data-slug');
				if (!slug) return;

				/* ---------- Like button ---------- */
				const likeBtn = document.getElementById('like-btn');
				const likeCountEl = document.getElementById('like-count');
				const likeStorageKey = 'liked:' + slug;

				function setLikedUI(liked, count) {
					if (!likeBtn || !likeCountEl) return;
					likeBtn.classList.toggle('is-liked', liked);
					likeBtn.setAttribute('aria-pressed', liked ? 'true' : 'false');
					const icon = likeBtn.querySelector('.like-icon');
					if (icon) icon.textContent = liked ? '♥' : '♡';
					likeCountEl.textContent = String(Math.max(0, count));
				}

				let likeBusy = false;
				let currentLiked = localStorage.getItem(likeStorageKey) === '1';
				let currentCount = 0;

				fetch('/api/like/' + encodeURIComponent(slug))
					.then(function (r) {
						return r.ok ? r.json() : { count: 0 };
					})
					.then(function (data) {
						currentCount = data.count || 0;
						setLikedUI(currentLiked, currentCount);
					})
					.catch(function () {
						setLikedUI(currentLiked, currentCount);
					});

				if (likeBtn) {
					likeBtn.addEventListener('click', function () {
						if (likeBusy) return;
						likeBusy = true;
						likeBtn.disabled = true;

						const nextLiked = !currentLiked;
						const optimisticCount = nextLiked ? currentCount + 1 : Math.max(0, currentCount - 1);
						setLikedUI(nextLiked, optimisticCount);

						fetch('/api/like/' + encodeURIComponent(slug), {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ action: nextLiked ? 'like' : 'unlike' }),
						})
							.then(function (r) {
								return r.ok ? r.json() : null;
							})
							.then(function (data) {
								if (data && typeof data.count === 'number') {
									currentCount = data.count;
								} else {
									currentCount = optimisticCount;
								}
								currentLiked = nextLiked;
								localStorage.setItem(likeStorageKey, currentLiked ? '1' : '0');
								setLikedUI(currentLiked, currentCount);
							})
							.catch(function () {
								setLikedUI(currentLiked, currentCount);
							})
							.finally(function () {
								likeBusy = false;
								likeBtn.disabled = false;
							});
					});
				}

				/* ---------- Comments ---------- */
				const list = document.getElementById('comments-list');
				const form = document.getElementById('comment-form');
				const nameInput = document.getElementById('comment-name');
				const contentInput = document.getElementById('comment-content');
				const charCount = document.getElementById('comment-char-count');
				const statusLine = document.getElementById('comment-status');
				const submitBtn = document.getElementById('comment-submit');

				function renderComments(comments) {
					if (!list) return;
					if (!comments || !comments.length) {
						list.innerHTML = '<li class="comments-status-line">還沒有留言，來當第一個留言的人吧。</li>';
						return;
					}
					list.innerHTML = comments
						.map(function (c) {
							const date = new Date(c.createdAt);
							const dateLabel = isNaN(date.getTime())
								? ''
								: date.getFullYear() + ' 年 ' + (date.getMonth() + 1) + ' 月 ' + date.getDate() + ' 日';
							return (
								'<li><span class="comment-author">' +
								c.name +
								'</span><span class="comment-date">' +
								dateLabel +
								'</span><p class="comment-body">' +
								c.contentHtml +
								'</p></li>'
							);
						})
						.join('');
				}

				function loadComments() {
					if (!list) return;
					fetch('/api/comments/' + encodeURIComponent(slug))
						.then(function (r) {
							return r.ok ? r.json() : { comments: [] };
						})
						.then(function (data) {
							renderComments(data.comments || []);
						})
						.catch(function () {
							list.innerHTML = '<li class="comments-status-line">留言載入失敗，請稍後重新整理頁面。</li>';
						});
				}

				loadComments();

				if (contentInput && charCount) {
					contentInput.addEventListener('input', function () {
						charCount.textContent = contentInput.value.length + ' / 500';
					});
				}

				const toolbar = document.querySelector('.comment-toolbar');
				if (toolbar && contentInput) {
					toolbar.addEventListener('click', function (e) {
						const btn = e.target.closest('button[data-cmd]');
						if (!btn) return;
						const cmd = btn.getAttribute('data-cmd');
						const start = contentInput.selectionStart || 0;
						const end = contentInput.selectionEnd || 0;
						const value = contentInput.value;
						const selected = value.slice(start, end);
						let insertBefore = '';
						let insertAfter = '';
						let placeholder = '';

						if (cmd === 'bold') {
							insertBefore = '**';
							insertAfter = '**';
							placeholder = '粗體文字';
						} else if (cmd === 'italic') {
							insertBefore = '*';
							insertAfter = '*';
							placeholder = '斜體文字';
						} else if (cmd === 'link') {
							insertBefore = '[';
							insertAfter = '](https://)';
							placeholder = '連結文字';
						} else if (cmd === 'newline') {
							const newValue = value.slice(0, start) + '\n' + value.slice(end);
							contentInput.value = newValue;
							contentInput.focus();
							contentInput.selectionStart = contentInput.selectionEnd = start + 1;
							if (charCount) charCount.textContent = newValue.length + ' / 500';
							return;
						}

						const middle = selected || placeholder;
						const newValue = value.slice(0, start) + insertBefore + middle + insertAfter + value.slice(end);
						contentInput.value = newValue;
						contentInput.focus();
						const selStart = start + insertBefore.length;
						contentInput.selectionStart = selStart;
						contentInput.selectionEnd = selStart + middle.length;
						if (charCount) charCount.textContent = newValue.length + ' / 500';
					});
				}

				if (form) {
					form.addEventListener('submit', function (e) {
						e.preventDefault();
						const content = (contentInput && contentInput.value.trim()) || '';
						if (!content) {
							if (statusLine) {
								statusLine.textContent = '留言內容不能為空';
								statusLine.className = 'comment-status-line is-error';
							}
							return;
						}
						const name = (nameInput && nameInput.value.trim()) || '';

						if (submitBtn) submitBtn.disabled = true;
						if (statusLine) {
							statusLine.textContent = '送出中...';
							statusLine.className = 'comment-status-line';
						}

						fetch('/api/comments/' + encodeURIComponent(slug), {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ name: name, content: content.slice(0, 500) }),
						})
							.then(function (r) {
								if (!r.ok) throw new Error('failed');
								return r.json();
							})
							.then(function (data) {
								if (statusLine) {
									statusLine.textContent = '留言成功！';
									statusLine.className = 'comment-status-line is-success';
								}
								if (contentInput) contentInput.value = '';
								if (nameInput) nameInput.value = '';
								if (charCount) charCount.textContent = '0 / 500';
								if (data && data.comment && list) {
									if (list.querySelector('.comments-status-line')) {
										list.innerHTML = '';
									}
									const c = data.comment;
									const date = new Date(c.createdAt);
									const dateLabel = isNaN(date.getTime())
										? ''
										: date.getFullYear() + ' 年 ' + (date.getMonth() + 1) + ' 月 ' + date.getDate() + ' 日';
									const li = document.createElement('li');
									li.innerHTML =
										'<span class="comment-author">' +
										c.name +
										'</span><span class="comment-date">' +
										dateLabel +
										'</span><p class="comment-body">' +
										c.contentHtml +
										'</p>';
									list.appendChild(li);
								}
							})
							.catch(function () {
								if (statusLine) {
									statusLine.textContent = '送出失敗，請稍後再試一次。';
									statusLine.className = 'comment-status-line is-error';
								}
							})
							.finally(function () {
								if (submitBtn) submitBtn.disabled = false;
							});
					});
				}
			})();
		</script>
	</body>
</html>
